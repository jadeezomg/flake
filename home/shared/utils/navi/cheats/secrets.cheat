% secrets, sops

; This flake uses sops-nix with age keys; the store is secrets/secrets.yaml.

# Edit flake secrets (decrypts, re-encrypts on save)
sops "$FLAKE/secrets/secrets.yaml"

# Edit any sops-encrypted file
sops <file>

$ file: fd -e yaml -e yml -e json --type f

# View decrypted contents without editing
sops -d <file>

$ file: fd -e yaml -e yml -e json --type f

# Encrypt a new file in-place (needs .sops.yaml config)
sops -e -i <file>

$ file: fd --type f

# Rotate data key (re-encrypt for current recipients)
sops -r -i <file>

$ file: fd -e yaml -e yml -e json --type f

# Update keys after editing .sops.yaml
sops updatekeys <file>

$ file: fd -e yaml -e yml -e json --type f

% age

# Generate a new age keypair (saves private key to file)
age-keygen -o <out>

$ out: echo "$HOME/.config/sops/age/keys.txt"

# Show the public key of a keyfile
age-keygen -y <keyfile>

$ keyfile: echo "$HOME/.config/sops/age/keys.txt"

# Encrypt a file to a recipient
age -r <pubkey> -o <out> <in>

$ pubkey: echo ""
$ out: echo "secret.age"
$ in: fd --type f

# Encrypt to multiple recipients
age -r <a> -r <b> -o <out> <in>

$ a: echo ""
$ b: echo ""
$ out: echo "secret.age"
$ in: fd --type f

# Decrypt with identity file
age -d -i <keyfile> -o <out> <in>

$ keyfile: echo "$HOME/.config/sops/age/keys.txt"
$ out: echo "decrypted.out"
$ in: fd -e age --type f

# Encrypt with a passphrase (symmetric)
age -p -o <out> <in>

$ out: echo "secret.age"
$ in: fd --type f

% flake-setup

# Bootstrap age key on Darwin via the just recipe
just setup-age-darwin

# Show current host's age public key (NixOS derived from ssh host key)
ssh-keyscan -q -t ed25519 localhost 2>/dev/null | awk '{print $3}' | ssh-to-age
