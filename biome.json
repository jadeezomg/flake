{
	"$schema": "https://biomejs.dev/schemas/2.4.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},
	"formatter": {
		"formatWithErrors": true
	},
	"files": {
		"includes": [
			"**",
			"!!**/.git",
			"!!**/.claude",
			"!!**/.direnv",
			"!!**/.cache",
			"!!**/node_modules",
			"!!**/.venv",
			"!!result",
			"!!result-*"
		]
	},
	"overrides": [
		{
			"includes": ["data/files/pear-desktop.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
