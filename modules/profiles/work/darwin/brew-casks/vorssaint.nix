{ lib, ... }:
let
  # Generated by `just vorssaint-sync`; see scripts/README.md.
  data = import ./data/vorssaint.nix;
in
{
  # Vorssaint - modular macOS menu bar toolkit
  # https://github.com/vorssaint/vorssaint-utils
  #
  # To change a setting, change it in Vorssaint, run `just vorssaint-sync`,
  # and commit data/vorssaint.nix. The sync leaves out app state, such as
  # onboarding markers, migration flags, window sizes and per-display caches.
  #
  # `defaults import` merges keys, so keys not in the data file keep the
  # values the app wrote. Activation writes these values at each switch but
  # does not lock them. Vorssaint reads its settings at launch: restart it
  # after a switch.
  #
  # Choices to keep when you change settings in the app:
  # - middleClick, superKey, screenshot, screenOCR and mediaTools replace the
  #   MiddleClick, Hyperkey and Shottr casks.
  # - superKeyModifiers must keep all four modifiers: Handy uses Hyper+Space.
  # - clipboardHistory stays off: Vicinae owns clipboard history on every host.
  # - musicBlock stays off: noTunes also stops Music launches from headphones,
  #   and the Vorssaint blocker does not.
  targets.darwin.defaults."com.vorssaint.utils" =
    lib.mapAttrs' (name: lib.nameValuePair "featureAvailable.${name}") data.features // data.settings;
}
