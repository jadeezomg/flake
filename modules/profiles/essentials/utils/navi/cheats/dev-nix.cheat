% nix, dev

; For the flake lifecycle (switch/build/gc), see the `flake` cheatsheet.
; This sheet focuses on ad-hoc nix development.

% nix, format

# Format .nix files with treefmt/nixfmt (flake's canonical formatter)
treefmt <path>

$ path: fd -e nix --type f

# Format quietly
treefmt -q <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

# Check formatting (CI mode)
treefmt --fail-on-change -q <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

% nix, lint

# Remove unused bindings (deadnix, modify in place)
deadnix --edit <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

# Just report, don't modify
deadnix <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

# Lint antipatterns (statix)
statix check <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

# Auto-fix what statix can
statix fix <path>

$ path: echo ". $FLAKE" | tr ' ' '\n'

% nix, search

; The flake rule: verify a package with `nix search` before adding it.

# Search nixpkgs (builtin)
nix search nixpkgs <query>

$ query: echo ""

# Pretty TUI search (nix-search from nixpkgs)
nix-search <query>

$ query: echo ""

# Search NixOS options online
echo 'https://search.nixos.org/options?query=<query>'

$ query: echo ""

# Search home-manager options online
echo 'https://nix-community.github.io/home-manager/options.xhtml'

% nix, build

# Build a flake output
nix build <flake>#<output>

$ flake: echo "."
$ output: echo ""

# Build without writing result symlink
nix build <flake> --no-link --print-out-paths

$ flake: echo "."

# Run an app from a flake
nix run <flake>#<app>

$ flake: echo "."
$ app: echo ""

# One-shot package use (ephemeral shell)
nix shell nixpkgs#<pkg>

$ pkg: echo ""

# Temporary run without installing (cached)
nix run nixpkgs#<pkg>

$ pkg: echo ""

% nix, flake

# Flake metadata
nix flake metadata <flake>

$ flake: echo "."

# Show all outputs
nix flake show <flake>

$ flake: echo "."

# Check the flake (eval + builds all checks)
nix flake check <flake>

$ flake: echo "."

# Update a single input
nix flake update <input> --flake <flake>

$ input: nix flake metadata --json 2>/dev/null | jq -r '.locks.nodes.root.inputs | keys[]'
$ flake: echo "."

# Update every input
nix flake update --flake <flake>

$ flake: echo "."

% nix, repl

# Open nix repl loaded with nixpkgs
nix repl --expr 'import <nixpkgs> {}'

# Load a flake into the repl (`:lf .`)
nix repl

% nix, store

# Explore the store as a tree (TUI)
nix-tree <path>

$ path: echo "/run/current-system;$(nix build --no-link --print-out-paths nixpkgs#hello 2>/dev/null)" | tr ';' '\n'

# Top-like process monitor for running nix builds
nix-top

# Disk usage of the store
nix-du | less

# Compare two generations (size + package diff)
nix store diff-closures <a> <b>

$ a: echo "/run/current-system"
$ b: echo "/nix/var/nix/profiles/system"

# Show why a path is in the closure
nix why-depends <drv> <dep>

$ drv: echo "/run/current-system"
$ dep: echo ""

# Prefetch a GitHub source (compute hash)
nix-prefetch-github <owner> <repo> --rev <rev>

$ owner: echo ""
$ repo: echo ""
$ rev: echo "main"

# Prettier build output (for interactive use)
nom build <flake>#<output>

$ flake: echo "."
$ output: echo ""

% nix, devshell

# Enter the default devShell for a flake
nix develop <flake>

$ flake: echo "."

# Run a single command in the devShell
nix develop <flake> --command <cmd>

$ flake: echo "."
$ cmd: echo ""

# devenv: enter dev environment (uses devenv.nix)
devenv shell

# devenv: run a one-off command
devenv shell -- <cmd>

$ cmd: echo ""

# Allow direnv for this directory (uses nix-direnv)
direnv allow

# Reload direnv
direnv reload

% nix, agent, sandbox, nono

; nono profiles are the single sandboxing layer for coding agents — see
; lib/nono-profiles.nix and docs/adr/0001-nono-as-single-sandboxing-system.md.
; Profile JSONs are installed by HM to ~/.config/nono/profiles/.
; For day-to-day agent launches use the `agent` dispatcher (see `llm` cheats).
; The devShells below are the lower-level entry kept for ad-hoc use.

# Enter Claude in its sandbox via the flake devShell
nix develop <flake>#nono-claude

$ flake: echo "$FLAKE"

# Enter pi in its sandbox via the flake devShell
nix develop <flake>#nono-pi

$ flake: echo "$FLAKE"

# Why was a path or host denied/granted by a profile?
nono why --profile <profile> --path <path> --op readwrite
nono why --profile <profile> --host <host> --port <port>

$ profile: ls ~/.config/nono/profiles/ | sed 's/.json$//'

# Show the resolved capability set for a profile
nono profile show <profile>

$ profile: ls ~/.config/nono/profiles/ | sed 's/.json$//'

# Inspect detached sessions / attach / stop
nono ps
nono attach <session>
nono stop <session>

$ session: nono ps --quiet

% nix, comma, nix-index, nurl, nix-init, direnv

; Installed as system packages (see `modules/shared/utils/nix.nix`).

# Run a program from nixpkgs without installing it (comma; shell alias `,` is common)
comma <cmd>

$ cmd: echo ""

# Open a subshell with the derivation that contains the executable
comma -s <cmd>

$ cmd: echo ""

# Show which nixpkgs attribute provides the executable
comma -p <cmd>

$ cmd: echo ""

# Print the store path of the resolved executable
comma -x <cmd>

$ cmd: echo ""

# Build the file index used by nix-locate (slow; re-run when channels change)
nix-index

# Find packages containing a path fragment (after `nix-index`)
nix-locate '<pattern>'

$ pattern: echo "bin/rg"

# nix-locate: treat pattern as regex
nix-locate -r '<regex>'

$ regex: echo ""

# nix-locate: only executables
nix-locate -t x '<pattern>'

$ pattern: echo ""

# Emit a Nix fetcher snippet from a repo URL (for flakes / packages)
nurl <url> <rev>

$ url: echo "https://github.com/nix-community/nurl"
$ rev: echo "main"

# Scaffold a package expression with hash prefetch (Cargo, npm, etc.)
nix-init

# nix-init: target path or output file
nix-init <output>

$ output: echo "default.nix"

# nix-init: from URL + revision
nix-init -u <url> --rev <rev>

$ url: echo ""
$ rev: echo "main"

# .envrc line for this directory's flake devShell (nix-direnv); then `direnv allow`
echo use flake

% nix, lsp

; LSPs already configured in editors; these are the binaries if you need to invoke them.

# Start nil LSP (zed/helix handle this automatically)
nil

# Start nixd LSP
nixd

% nix, melt

# Ranger-like flake.lock viewer
nix-melt

% nix, troubleshoot, logs

# Show the build log of a failed/finished build
nix log <installable>

$ installable: echo ".#"

# Build with full build logs streamed (-L) and a stack trace
nix build <installable> -L --show-trace

$ installable: echo ".#"

# Keep the failed build dir for inspection (path printed in error)
nix build <installable> --keep-failed

$ installable: echo ".#"

# Rebuild a path deterministically and diff against the store (impurity check)
nix build <installable> --rebuild

$ installable: echo ".#"

% nix, troubleshoot, eval

# Evaluate a flake attribute (quick smoke test)
nix eval <flake>#<attr>

$ flake: echo "."
$ attr: echo ""

# Evaluate with trace on error
nix eval <flake>#<attr> --show-trace

$ flake: echo "."
$ attr: echo ""

# Drop into the debugger at the failure point (:env, :st to inspect)
nix eval <flake>#<attr> --debugger

$ flake: echo "."
$ attr: echo ""

# Show the derivation behind an installable (env, inputs, builder)
nix derivation show <installable> | jq . | less

$ installable: echo ".#"

# Effective nix.conf (spot bad substituters, sandbox, experimental features)
nix config show

# Pinned flake registry entries (why is nixpkgs not what you expect?)
nix registry list

# System diagnostics (nix version, channels, sandbox, store)
nix run nixpkgs#nix-info -- -m

% nix, troubleshoot, store

# Verify store path integrity (hash + signatures)
nix store verify <path>

$ path: echo "/run/current-system"

# Verify the whole store's contents (slow)
nix-store --verify --check-contents

# Repair a corrupted store path from substituters
sudo nix store repair <path>

$ path: echo ""

# Closure size of a path (what's really being pulled in)
nix path-info -rsSh <installable> | sort -hk2 | tail -n 25

$ installable: echo "/run/current-system"

# Check whether a path is available in binary caches (avoid a local build)
nix path-info --store https://cache.nixos.org <installable>

$ installable: echo ""

% nix, troubleshoot, gc-roots

# What keeps a store path alive? (GC roots pointing at it)
nix-store --query --roots <path>

$ path: echo ""

# List every GC root on the system
nix-store --gc --print-roots | rg -v '/proc/' | less

# Dry-run GC: what would be deleted and how much
nix store gc --dry-run 2>&1 | tail -n 5

% nix, troubleshoot, hash

# Fix a fetcher hash mismatch: convert the "got:" hash to SRI
nix hash convert --hash-algo sha256 <hash>

$ hash: echo ""

# Prefetch a URL and print its SRI hash
nix store prefetch-file <url>

$ url: echo ""

; Tip: set the hash to `lib.fakeHash`, build once, copy the "got:" value.
