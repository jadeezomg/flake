% llm, agent, sandbox, nono

; Single sandboxed entry point for every coding agent. Per-agent identity
; (claude-jadee, pi-jadee), broker-injected creds, Co-Authored-By trailer.
; Implementation: lib/nono-profiles.nix. ADR: docs/adr/0001-nono-as-single-sandboxing-system.md.

# List available agents
agent ls

# Launch an agent in its sandbox (foreground TUI)
agent <agent>

$ agent: agent ls

# Pass arguments through to the agent
agent <agent> <args>

$ agent: agent ls
$ args: echo ""

# One-line summary of running sessions (banner-friendly)
agent status

# Verify keyring, podman, profiles
agent doctor

# List running / detached sandbox sessions
agent ps

# Attach to a detached session (Ctrl-] d to detach)
agent attach <session>

$ session: nono ps --quiet

# Stop a running session
agent stop <session>

$ session: nono ps --quiet

% llm, claude

; Claude Code CLI — direct (unsandboxed) invocations. For sandboxed runs use
; `agent claude` from the agent-dispatcher cheat above.

# Start an interactive session (cwd as context)
claude

# One-shot query, non-interactive
claude -p '<prompt>'

$ prompt: echo ""

# Resume the previous conversation
claude -c

# Continue a specific conversation by id
claude -r <id>

$ id: claude --list 2>/dev/null | awk 'NR>1 {print $1}'

# Specify model explicitly
claude --model <model>

$ model: echo "claude-sonnet-4-5;claude-opus-4-5;claude-haiku-4-5" | tr ';' '\n'

# Pipe file contents as prompt
cat <file> | claude -p '<prompt>'

$ file: fd --type f
$ prompt: echo ""

% llm, pi

# Ask Pi a one-shot question
p <question>

$ question: echo ""

# Pipe command output into Pi shortcut
<command> | p <question>

$ command: echo "just <recipe>"
$ question: echo "what is this"

% docs, ctx7, context7

; ctx7 fetches up-to-date library docs; prefer it over web-search for APIs.

# Resolve a library id (prints matches)
ctx7 library '<name>' '<question>'

$ name: echo ""
$ question: echo ""

# Fetch docs for a resolved id (e.g. /vercel/next.js)
ctx7 docs <id> '<question>'

$ id: echo ""
$ question: echo ""

# Version-pinned docs
ctx7 docs <id>/<version> '<question>'

$ id: echo ""
$ version: echo ""
$ question: echo ""

# Login for higher API quota
ctx7 login

% docs, navi

; Reach for these when you want a cheat but don't have one locally.

# tldr pages via navi (fast, curated)
navi --tldr <cmd>

$ cmd: echo ""

# cheat.sh via navi (community one-liners)
navi --cheatsh <cmd>

$ cmd: echo ""

# man page via bat (syntax-highlighted man)
MANPAGER='sh -c "col -bx | bat -l man -p"' man <cmd>

$ cmd: echo ""
