// Noctalia v5 IPC keybinds (niri compositor side).
// Docs: https://docs.noctalia.dev/v5/ipc/
// Control center: https://docs.noctalia.dev/v5/control-center/

binds {
    Mod+Space repeat=false hotkey-overlay-title="Application Launcher" {
        spawn "vicinae" "toggle";
    }
    Mod+V hotkey-overlay-title="Clipboard Manager" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard";
    }
    Mod+Comma hotkey-overlay-title="Settings" {
        spawn "noctalia" "msg" "settings-toggle";
    }
    Mod+N hotkey-overlay-title="Notification Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "notifications";
    }
    Mod+M hotkey-overlay-title="System Monitor" {
        spawn "noctalia" "msg" "panel-toggle" "control-center" "system";
    }
    Mod+L hotkey-overlay-title="Lock Screen" {
        spawn "noctalia" "msg" "session" "lock";
    }
    // Super+X hotkey-overlay-title="Power Menu" {
    //     spawn "noctalia" "msg" "panel-toggle" "session";
    // }
    Mod+Shift+Y hotkey-overlay-title="Browse Wallpapers" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper";
    }

    Mod+Tab { spawn "noctalia" "msg" "window-switcher"; }

    Print hotkey-overlay-title="Screenshot: Region" {
        spawn "noctalia" "msg" "screenshot-region";
    }
    Alt+Print hotkey-overlay-title="Screenshot: Focused Monitor" {
        spawn "noctalia" "msg" "screenshot-fullscreen";
    }
    Ctrl+Print hotkey-overlay-title="Screenshot: All Monitors" {
        spawn "noctalia" "msg" "screenshot-fullscreen" "all";
    }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    Mod+Shift+P { spawn "noctalia" "msg" "dpms-off"; }
}
