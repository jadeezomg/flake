	"model": "opus",
	"env": {
		"CLAUDE_CODE_PLUGIN_DIRS": "~/git/flake/data/agents/mods/stereo-view",
		"CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
	},
	"enabledPlugins": {
		"caya-working-docs@caya": true,
		"caya-customer-api@caya": true,
		"caya-design-system@caya": true,
		"caya-mailroom-api@caya": true,
		"simple-english@simple-english": true,
		"typescript-lsp@claude-plugins-official": true,
		"caya-customer-ops@caya": true,
		"ponytail@ponytail": true
	},
	"extraKnownMarketplaces": {
		"caya": {
			"source": {
				"source": "github",
				"repo": "AMN-DATA/claude-plugin"
			},
			"autoUpdate": true
		},
		"simple-english": {
			"source": {
				"source": "github",
				"repo": "AminBlg/SimpleEnglish"
			},
			"autoUpdate": true
		},
		"mattpocock": {
			"source": {
				"source": "github",
				"repo": "mattpocock/skills"
			},
			"autoUpdate": true
		},
		"ponytail": {
			"source": {
				"source": "github",
				"repo": "DietrichGebert/ponytail"
			},
			"autoUpdate": true
		}
	},
	"feedbackDrafts": "notify",
	"effortLevel": "medium",
	"pluginConfigs": {
		"cc-plugin-agents-md@builtin": {
			"options": {
				"instructionFiles": "claude-md-and-agents-md"
			}
		}
	},
	"tui": "fullscreen",
	"timeFormat": "24-hour",
	"skipDangerousModePermissionPrompt": true,
	"theme": "custom:dark-ansi-dock",
	"editorMode": "normal",
	"preferredNotifChannel": "kitty",
	"autoCompactEnabled": true,
	"idleCompaction": false,
	"cleanupPeriodDays": 120,
	"switchModelsOnFlag": false,
	"showTurnDuration": true,
	"remoteControlAtStartup": true,
	"inputNeededNotifEnabled": false,
	"agentPushNotifEnabled": false,
	"modelSettings": {
		"claude-opus-5-5": {
			"effortLevel": "xhigh"
		}
	},
	"hooks": {
		"SessionStart": [
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "bash '/home/jadee/.claude/hooks/herdr-agent-state.sh' session",
						"timeout": 10
					}
				]
			},
			{
				"hooks": [
					{
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5,
						"type": "command"
					}
				]
			},
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "bash '/Users/jonashippauf/.claude/hooks/herdr-agent-state.sh' session",
