{
	"cleanupPeriodDays": 120,
	"env": {
		"CLAUDE_CODE_PLUGIN_DIRS": "~/git/flake/data/agents/mods/stereo-view",
		"CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
	},
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"permissions": {
		"allow": [
			"mcp__mcp-nixos__nix",
			"mcp__mcp-nixos__nix_versions",
			"mcp__mcp-server-github__pull_request_read",
			"WebSearch",
			"WebFetch(domain:api.github.com)",
			"WebFetch(domain:crates.io)",
			"WebFetch(domain:docs.anthropic.com)",
			"WebFetch(domain:docs.nono.sh)",
			"WebFetch(domain:fencesandbox.com)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:home-manager-options.extranix.com)",
			"WebFetch(domain:nono.sh)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:registry.npmjs.org)",
			"WebFetch(domain:wiki.nixos.org)",
			"WebFetch(domain:zed.dev)",
			"Read(//etc/**)",
			"Read(//home/jadee/**)",
			"Read(//nix/store/**)",
			"Read(//nix/var/**)",
			"Read(//run/current-system/**)",
			"Read(//tmp/**)",
			"Bash(agent *)",
			"Bash(agent-review *)",
			"Bash(claude mcp *)",
			"Bash(ctx7 *)",
			"Bash(nono *)",
			"Bash(omp *)",
			"Bash(pi *)",
			"Bash(flake *)",
			"Bash(home-manager *)",
			"Bash(just *)",
			"Bash(nix *)",
			"Bash(nix-instantiate *)",
			"Bash(nix-shell *)",
			"Bash(nix-store *)",
			"Bash(NIXPKGS_ALLOW_UNFREE=1 nix *)",
			"Bash(UPDATE_FORCE=1 just *)",
			"Bash(env *)",
			"Bash(gh *)",
			"Bash(git *)",
			"Bash(awk *)",
			"Bash(bzcat *)",
			"Bash(cat *)",
			"Bash(eza *)",
			"Bash(fd *)",
			"Bash(find *)",
			"Bash(grep *)",
			"Bash(host-status *)",
			"Bash(jq *)",
			"Bash(readlink *)",
			"Bash(rg *)",
			"Bash(sed *)",
			"Bash(stat *)",
			"Bash(treefmt *)",
			"Bash(xargs *)",
			"Bash(curl *)",
			"Bash(kagi *)",
			"Bash(kagi-ken-cli *)",
			"Bash(scp *)",
			"Bash(ssh *)",
			"Bash(xh *)",
			"Bash(bun *)",
			"Bash(npm *)",
			"Bash(npx *)",
			"Bash(nu *)",
			"Bash(python3 *)",
			"Bash(timeout *)",
			"Bash(uv *)",
			"Bash(uvx *)",
			"Bash(bash *)",
			"Bash(busctl *)",
			"Bash(getent *)",
			"Bash(journalctl *)",
			"Bash(ls *)",
			"Bash(mount *)",
			"Bash(pkill *)",
			"Bash(shellcheck *)",
			"Bash(sudo *)",
			"Bash(systemctl *)",
			"Bash(tee *)",
			"Bash(trash *)",
			"Bash(cp *)",
			"Bash(mkdir *)",
			"Bash(echo *)"
		],
		"defaultMode": "auto"
	},
	"model": "opus",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "^(startup|resume|clear|compact|fork)$",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
						"timeout": 10
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"PreToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 310
					}
				]
			}
		],
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"PermissionDenied": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"ElicitationResult": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"StopFailure": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "tuios agent-hook claude-code --integration 3",
						"timeout": 5
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"caya-working-docs@caya": true,
		"caya-customer-api@caya": true,
		"caya-design-system@caya": true,
		"caya-mailroom-api@caya": true,
		"simple-english@simple-english": true,
		"typescript-lsp@claude-plugins-official": true,
		"caya-customer-ops@caya": true,
		"ponytail@ponytail": true,
		"caya-cowork-git@synced": false,
		"caya-phil@synced": false,
		"cowork-plugin-management@synced": false,
		"cc-plugin-diff@builtin": false,
		"cc-plugin-telemetry@builtin": false,
		"caya-engineering@synced": false,
		"caya-plugin-maintenance@synced": false
	},
	"extraKnownMarketplaces": {
		"caya": {
			"source": {
				"source": "github",
				"repo": "AMN-DATA/claude-plugin"
			},
			"autoUpdate": true
		},
		"simple-english": {
			"source": {
				"source": "github",
				"repo": "AminBlg/SimpleEnglish"
			},
			"autoUpdate": true
		},
		"ponytail": {
			"source": {
				"source": "github",
				"repo": "DietrichGebert/ponytail"
			},
			"autoUpdate": true
		}
	},
	"feedbackDrafts": "notify",
	"effortLevel": "medium",
	"modelSettings": {
		"claude-opus-5-5": {
			"effortLevel": "xhigh"
		}
	},
	"pluginConfigs": {
		"cc-plugin-agents-md@builtin": {
			"options": {
				"instructionFiles": "claude-md-and-agents-md"
			}
		},
		"ponytail@ponytail": {
			"options": {
				"ledger": false
			}
		}
	},
	"tui": "fullscreen",
	"timeFormat": "24-hour",
	"skipDangerousModePermissionPrompt": true,
	"theme": "custom:dark-ansi-dock",
	"editorMode": "normal",
	"preferredNotifChannel": "kitty",
	"autoCompactEnabled": true,
	"idleCompaction": false,
	"switchModelsOnFlag": false,
	"showTurnDuration": true,
	"remoteControlAtStartup": true,
	"inputNeededNotifEnabled": false,
	"agentPushNotifEnabled": false,
