{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git"
	},
	"files": {
		"includes": [
			"**",
			"!!**/.git",
			"!!**/.claude",
			"!!**/.direnv",
			"!!**/node_modules",
			"!!**/.venv",
			"!!result",
			"!!result-*"
		]
	},
	"html": {
		"formatter": {
			"enabled": true
		}
	}
}
